# Leave VITE_API_BASE_URL empty to use the Vite /api proxy in local development.
VITE_API_BASE_URL=

# Target for the Vite development/preview proxy.
VITE_API_PROXY_TARGET=http://localhost:8000

# Used only if an old Vite process returns 404 for /api/logs.
VITE_API_FALLBACK_URL=http://localhost:8000
