FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=10485760
INTELLIGRAPH_DATA_PATH=data/knowledge_base.json
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=intelligraph_chunks

# Enable after starting Neo4j with docker compose.
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j
